<!-- Winnow GUI preview. @@key@@ tokens are replaced with config/i18n.json strings before loading. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winnow" Width="1120" Height="740" MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="{DynamicResource Fg}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- Theme brushes; replaced from code with the light or dark set -->
    <SolidColorBrush x:Key="Bg" Color="#202020"/>
    <SolidColorBrush x:Key="Pane" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="Card" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="CardBorder" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Fg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FgDim" Color="#A8A8A8"/>
    <SolidColorBrush x:Key="Hover" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="Selected" Color="#343434"/>
    <SolidColorBrush x:Key="Accent" Color="#34D399"/>
    <SolidColorBrush x:Key="AccentFg" Color="#062B1F"/>
    <SolidColorBrush x:Key="AccentText" Color="#34D399"/>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Margin" Value="8,2"/>
      <Setter Property="GroupName" Value="nav"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" CornerRadius="6" Background="Transparent">
              <Grid>
                <Border x:Name="pill" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                        Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                             FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center"/>
                  <ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Selected}"/>
                <Setter TargetName="pill" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="Padding" Value="16,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="5" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.72"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Fg}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Big clickable card used for quick actions on the home page -->
    <Style x:Key="CardBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="8" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1" Padding="18,14">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Box" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" CornerRadius="5" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,1,1,2">
              <Grid>
                <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource FgDim}" Margin="12,0" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value=""><Setter TargetName="hint" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Check box whose content is the whole row, so clicking anywhere on the row toggles it -->
    <Style x:Key="Row" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="bd" CornerRadius="6" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="14,10" Margin="0,0,0,4">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="box" Width="20" Height="20" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource FgDim}" VerticalAlignment="Center">
                  <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource AccentFg}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Border>
                <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Plain" TargetType="ListBoxItem">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="RowTemplate">
      <CheckBox Style="{StaticResource Row}" IsChecked="{Binding Selected, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource FgDim}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
          <Border Grid.Column="1" CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center"
                  Background="{Binding BadgeBg}" Visibility="{Binding BadgeVisibility}">
            <TextBlock Text="{Binding Badge}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding BadgeFg}"/>
          </Border>
        </Grid>
      </CheckBox>
    </DataTemplate>

    <Style x:Key="List" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource Plain}"/>
      <Setter Property="ItemTemplate" Value="{StaticResource RowTemplate}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
      <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    </Style>

    <!-- Slim scroll bar: thumb only, no arrows -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border CornerRadius="3" Background="{DynamicResource FgDim}" Opacity="0.45" Margin="2,0"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="8"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track">
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border CornerRadius="3" Background="{DynamicResource FgDim}" Opacity="0.45" Margin="0,2"/>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,4,0,16"/>
    </Style>
    <Style x:Key="Info" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Width" Value="250"/>
    </Style>
  </Window.Resources>

  <Grid Background="{DynamicResource Bg}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <!-- Sidebar -->
    <DockPanel Grid.RowSpan="2" Background="{DynamicResource Pane}">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,0,20">
        <Image x:Name="Logo" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Winnow" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock x:Name="VersionText" Foreground="{DynamicResource FgDim}" FontSize="12"/>
        </StackPanel>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16">
        <CheckBox x:Name="SimToggle" Foreground="{DynamicResource Fg}" Margin="4,0,0,10" Content="@@gui.sim@@"/>
        <TextBlock x:Name="ModeText" Foreground="{DynamicResource FgDim}" FontSize="12" TextWrapping="Wrap" Margin="4,0,0,12"/>
        <Button x:Name="LangBtn" Style="{StaticResource Btn}" Margin="0,0,0,8" HorizontalAlignment="Stretch">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE774;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="@@gui.langSwitch@@"/>
          </StackPanel>
        </Button>
        <Button x:Name="TerminalBtn" Style="{StaticResource Btn}" Margin="0" HorizontalAlignment="Stretch">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE756;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="@@gui.terminal@@"/>
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel>
        <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" Tag="&#xE80F;" Content="@@gui.navHome@@" IsChecked="True"/>
        <RadioButton x:Name="NavTweaks" Style="{StaticResource Nav}" Tag="&#xE713;" Content="@@gui.navTweaks@@"/>
        <RadioButton x:Name="NavApps" Style="{StaticResource Nav}" Tag="&#xE71D;" Content="@@gui.navApps@@"/>
        <RadioButton x:Name="NavNext" Style="{StaticResource Nav}" Tag="&#xE734;" Content="@@gui.navNext@@"/>
      </StackPanel>
    </DockPanel>

    <!-- Pages -->
    <Grid Grid.Column="1" Margin="36,28,36,12">
      <!-- Home -->
      <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource H1}" Text="@@gui.welcome@@"/>
          <TextBlock Style="{StaticResource Sub}" Text="@@tagline@@"/>
          <Border CornerRadius="8" Padding="16,12" Margin="0,0,8,20" BorderThickness="1" BorderBrush="{DynamicResource Accent}" Background="{DynamicResource Card}">
            <DockPanel>
              <TextBlock Text="&#xE946;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{DynamicResource AccentText}" VerticalAlignment="Top" Margin="0,1,12,0"/>
              <StackPanel>
                <TextBlock Text="@@gui.previewTitle@@" FontWeight="SemiBold"/>
                <TextBlock Text="@@gui.previewNote@@" TextWrapping="Wrap" Foreground="{DynamicResource FgDim}" Margin="0,4,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <TextBlock Text="@@gui.thisPc@@" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <WrapPanel x:Name="InfoPanel" Margin="0,0,0,20"/>
          <TextBlock Text="@@gui.quick@@" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <Button x:Name="QuickTweaks" Style="{StaticResource CardBtn}">
            <DockPanel>
              <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="{DynamicResource AccentText}" Margin="0,0,16,0" VerticalAlignment="Center"/>
              <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource FgDim}"/>
              <StackPanel><TextBlock Text="@@gui.qTweaks@@" FontWeight="SemiBold"/><TextBlock Text="@@gui.qTweaksHint@@" Foreground="{DynamicResource FgDim}" FontSize="12.5"/></StackPanel>
            </DockPanel>
          </Button>
          <Button x:Name="QuickApps" Style="{StaticResource CardBtn}">
            <DockPanel>
              <TextBlock Text="&#xE71D;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="{DynamicResource AccentText}" Margin="0,0,16,0" VerticalAlignment="Center"/>
              <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource FgDim}"/>
              <StackPanel><TextBlock Text="@@gui.qApps@@" FontWeight="SemiBold"/><TextBlock x:Name="QuickAppsHint" Foreground="{DynamicResource FgDim}" FontSize="12.5"/></StackPanel>
            </DockPanel>
          </Button>
          <Button x:Name="QuickTerminal" Style="{StaticResource CardBtn}">
            <DockPanel>
              <TextBlock Text="&#xE756;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="{DynamicResource AccentText}" Margin="0,0,16,0" VerticalAlignment="Center"/>
              <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource FgDim}"/>
              <StackPanel><TextBlock Text="@@gui.qTerminal@@" FontWeight="SemiBold"/><TextBlock Text="@@gui.qTerminalHint@@" Foreground="{DynamicResource FgDim}" FontSize="12.5"/></StackPanel>
            </DockPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>

      <!-- Tweaks -->
      <DockPanel x:Name="PageTweaks" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="UndoBtn" Style="{StaticResource Btn}" Content="@@gui.undo@@"/>
              <Button x:Name="ApplyBtn" Style="{StaticResource AccentBtn}" Margin="0" Content="@@gui.apply@@"/>
            </StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="@@gui.navTweaks@@"/>
          </DockPanel>
          <TextBlock Style="{StaticResource Sub}" Text="@@gui.tweaksSub@@"/>
          <DockPanel Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal">
              <TextBox x:Name="TweakFilter" Style="{StaticResource Box}" Width="220" Margin="0,0,12,0" Tag="@@gui.filter@@" AutomationProperties.Name="@@gui.filter@@"/>
              <TextBlock Text="@@gui.preset@@" VerticalAlignment="Center" Foreground="{DynamicResource FgDim}" Margin="0,0,8,0"/>
              <Button x:Name="PresetMinimal" Style="{StaticResource Btn}" Content="Minimal"/>
              <Button x:Name="PresetStandard" Style="{StaticResource Btn}" Content="Standard"/>
              <Button x:Name="PresetHeavy" Style="{StaticResource Btn}" Content="Heavy"/>
              <Button x:Name="PresetClear" Style="{StaticResource Btn}" Content="@@gui.clear@@"/>
            </WrapPanel>
          </DockPanel>
        </StackPanel>
        <ListBox x:Name="TweakList" Style="{StaticResource List}">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="2,14,0,8"/></DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
        </ListBox>
      </DockPanel>

      <!-- Apps -->
      <DockPanel x:Name="PageApps" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <DockPanel>
            <Button x:Name="InstallBtn" DockPanel.Dock="Right" Style="{StaticResource AccentBtn}" Margin="0" VerticalAlignment="Center" Content="@@gui.install@@"/>
            <TextBlock Style="{StaticResource H1}" Text="@@gui.navApps@@"/>
          </DockPanel>
          <TextBlock Style="{StaticResource Sub}" Text="@@gui.appsSub@@"/>
          <DockPanel Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="AppQuery" Style="{StaticResource Box}" Width="280" Margin="0,0,8,0" Tag="@@gui.appHint@@" AutomationProperties.Name="@@gui.appHint@@"/>
              <Button x:Name="SearchBtn" Style="{StaticResource Btn}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock Text="@@gui.searchWinget@@"/>
                </StackPanel>
              </Button>
              <Button x:Name="CatalogBtn" Style="{StaticResource Btn}" Content="@@gui.catalog@@"/>
              <TextBlock x:Name="AppCount" VerticalAlignment="Center" Foreground="{DynamicResource FgDim}" Margin="8,0,0,0"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
        <ListBox x:Name="AppList" Style="{StaticResource List}"/>
      </DockPanel>

      <!-- Coming next -->
      <ScrollViewer x:Name="PageNext" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource H1}" Text="@@gui.navNext@@"/>
          <TextBlock Style="{StaticResource Sub}" Text="@@gui.nextSub@@"/>
          <ItemsControl x:Name="NextList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Info}" Width="Auto" Margin="0,0,0,8">
                  <DockPanel>
                    <TextBlock Text="&#xE735;" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource AccentText}" Margin="0,2,12,0" VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="RepoBtn" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="@@gui.repo@@"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Status bar with the live log of the running task -->
    <Border Grid.Column="1" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardBorder}" Padding="36,8,36,10">
      <StackPanel>
        <DockPanel>
          <ToggleButton x:Name="LogToggle" DockPanel.Dock="Right" Content="@@gui.log@@" Foreground="{DynamicResource AccentText}"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,2">
            <ToggleButton.Template>
              <ControlTemplate TargetType="ToggleButton">
                <Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
              </ControlTemplate>
            </ToggleButton.Template>
          </ToggleButton>
          <ProgressBar x:Name="Busy" Width="90" Height="4" Margin="0,0,12,0" IsIndeterminate="True" Visibility="Collapsed"
                       Foreground="{DynamicResource Accent}" Background="{DynamicResource Selected}" BorderThickness="0"/>
          <TextBlock x:Name="StatusText" Foreground="{DynamicResource FgDim}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBox x:Name="LogBox" Visibility="Collapsed" Height="170" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="NoWrap"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Background="{DynamicResource Card}" Foreground="{DynamicResource Fg}" BorderBrush="{DynamicResource CardBorder}" Padding="8"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
